# Copy to .env in the repository root, next to main.py, and fill in the blanks.
#
#   cp .env.example .env
#
# Every module reads this same file: crawler/bin/save_remote.py, mailer.py,
# site_login.py, fetch_results.py, phatmal.py -- and the continuous-OCR service,
# which imports save_remote and mailer. The real environment always wins over
# anything written here, so a key can be exported instead of stored.
#
# .env is git-ignored; this example is not. Never commit real secrets.
# Format: KEY=VALUE, one per line. Blank lines and # comments are skipped,
# quotes are stripped, and a leading `export ` is allowed.

# --- remote upload (save_remote.py) -------------------------------------------
# Required for `main.py --push` and for the OCR service's SSH pull. Without
# SSH_HOST and SSH_USER the run stops with a RemoteError.
SSH_HOST=
SSH_USER=
SSH_PORT=22
# The remote directory that CONTAINS convertable/ - and scan/ or scanned/, which the
# OCR service reads. It mirrors this checkout's own pdfs/ folder, so both ends of the
# pipeline use the same name. Relative paths resolve against the ssh account's home,
# so this means <home>/pdfs/convertable/ on the shared host. Write an absolute path
# here ONLY if the files really are somewhere outside that home. Keep the value on
# one line with no spaces and no `~` - nothing expands it, it is used verbatim.
SSH_DIR=pdfs
# Optional path to a private key. Leave blank to use the ssh agent / default key.
SSH_KEY=

# --- run reports (mailer.py) ---------------------------------------------------
# SMTP host, port, user and recipient are fixed in mailer.py; only the password
# is a secret. Without it, mail is skipped and the reason is logged.
MAIL_PASSWORD=

# --- search (fetch_results.py) -------------------------------------------------
SERPAPI=

# --- Hugging Face dataset (hfinit.py) ------------------------------------------
# The access token labelled "hg_full". The name is HG_TOKEN - not HF_TOKEN, HF_KEY
# or HF_TOKEN variants; hfinit.py reads exactly this one (TOKEN_ENV in hfinit.py),
# and a differently-named key is silently ignored, so the upload then prompts or
# fails with "not logged in". Leave it blank and `uv run hfinit.py` will prompt once
# and cache the token, so later runs need nothing.
HG_TOKEN=

# --- phatmal library (phatmal.py) ----------------------------------------------
# All three are needed together, or the library download is skipped.
PHATMAL_EMAIL=
PHATMAL_PASSWORD=
PHATMAL_API_KEY=

# --- per-site login (site_login.py) --------------------------------------------
# Generic credentials used for every host:
LOGIN_EMAIL=
LOGIN_PASSWORD=
LOGIN_URL=
LOGIN_USER_FIELD=
LOGIN_PASS_FIELD=
#
# Per-host overrides take precedence. Substitute the host's token, upper-cased
# with non-alphanumerics replaced by _, e.g. for scribd.com:
#LOGIN_SCRIBD_COM_EMAIL=
#LOGIN_SCRIBD_COM_PASSWORD=

# --- PDF extraction safety cap (praser/pdf_extract.py) -------------------------
# Ceiling, in MB, on how far one compressed stream inside a PDF may expand. A
# decompression-bomb guard; the praser is the only component that opens
# containers. Default: 256
#PRASER_MAX_STREAM_MB=256

# --- deliberately NOT listed here ----------------------------------------------
# SCRAPER_SYSTEMD_CHILD and SCRAPER_SYSTEMD_DIRECT are internal re-exec guards
# read by scripts/systemd_launcher.py, which sets CHILD=1 on the detached unit it
# spawns. Writing either into .env would stop main.py from launching under
# systemd at all, so they belong in the process environment only.

# --- scribd export tuning (scribd.py) ------------------------------------------
# All optional; every one has a working default in the code. Uncomment only to
# change behaviour.
#SCRIBD_HEADLESS=1
#SCRIBD_CDP_TIMEOUT=
#SCRIBD_EXPORT_BATCH_SIZE=
#SCRIBD_PAGE_LOAD_CONCURRENCY=
#SCRIBD_PAGE_LOAD_TIMEOUT=
#SCRIBD_PDF_STREAM_CHUNK_SIZE=
#SCRIBD_RENDER_SETTLE_TIMEOUT=
#SCRIBD_SCROLL_DELAY=
