# Copy this file to .env (same folder as main.py) and fill in real values.
# NEVER commit .env — it holds secrets. Only .env.example is tracked.
#
# SerpApi key for the search stage:
#SERPAPI=your-serpapi-key
#
# Login for sites needing email + password. The crawlers log in once per
# host before crawling it; the session lasts for the whole run.
# Generic default (used for any host without host-specific keys):
#LOGIN_EMAIL=you@example.com
#LOGIN_PASSWORD=your-password
#
# Per-host keys beat the default. Uppercase the host, turn every run of
# non-letters/digits into one underscore:
#   mbookshelf.naingdroidapps.com -> MBOOKSHELF_NAINGDROIDAPPS_COM
#LOGIN_MBOOKSHELF_NAINGDROIDAPPS_COM_EMAIL=you@example.com
#LOGIN_MBOOKSHELF_NAINGDROIDAPPS_COM_PASSWORD=your-password
#
# Optional overrides, only when auto-detect gets it wrong:
#LOGIN_MBOOKSHELF_NAINGDROIDAPPS_COM_URL=https://mbookshelf.naingdroidapps.com/login
#LOGIN_MBOOKSHELF_NAINGDROIDAPPS_COM_USER_FIELD=email
#LOGIN_MBOOKSHELF_NAINGDROIDAPPS_COM_PASS_FIELD=password
#
# Phatmal API driver (Expo SPA site, driven via api.phatmal.com):
#PHATMAL_EMAIL=you@example.com
#PHATMAL_PASSWORD=your-password
#PHATMAL_API_KEY=client-key-from-the-app-requests
#
# Remote archive over SSH (used by --download-remote / Dcrawler's --remote):
# every saved file is pushed to the host, its sha256 is verified against the
# local bytes, and only then is the local copy deleted. Interrupted pushes
# resume on the next run; failures keep the file on disk and land in
# scan/failed.txt. SSH_KEY is the private key file on this box (~ allowed);
# leave it empty to let ssh use its own keys/agent. SSH_DIR is relative to
# the account's home on the host — keep it OUT of public_html.
#SSH_HOST=your-host.example.com
#SSH_PORT=22
#SSH_USER=your-ssh-user
#SSH_KEY=~/.ssh/id_ed25519
#SSH_DIR=books
